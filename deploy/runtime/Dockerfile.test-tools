FROM docker:28-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d AS docker-tools
FROM oven/bun:1.3.13
RUN apt-get update && apt-get install --yes --no-install-recommends python3 \
    && apt-get upgrade --yes --no-install-recommends && rm -rf /var/lib/apt/lists/*
COPY --from=docker-tools /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-tools /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /tmp

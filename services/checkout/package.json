{
	"name": "@avenos/checkout",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && bun run email:check && vite build",
		"preview": "vite preview",
		"start": "bun build/index.js",
		"email:studio": "bun tools/email/studio.ts",
		"email:preview": "maizzle serve",
		"email:compile": "bun tools/email/build.ts",
		"email:check": "bun tools/email/check.ts",
		"worker:email": "bun scripts/email-worker.ts",
		"worker:platform-events": "bun scripts/platform-event-worker.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "svelte-kit sync && bun run email:check && vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"db:seed:billing": "bun scripts/seed-billing.ts"
	},
	"dependencies": {
		"@avenos/http-boundary": "workspace:*",
		"@avenos/aven-identity": "workspace:*",
		"@myavenceo/aven-ceo": "0.13.2",
		"@polar-sh/sdk": "^0.49.0",
		"dotenv": "17.3.1",
		"drizzle-orm": "0.45.2",
		"nodemailer": "9.1.1",
		"pg": "8.16.3",
		"pino": "10.3.1",
		"standardwebhooks": "^1.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@maizzle/framework": "6.1.0",
		"@maizzle/tailwindcss": "1.5.6",
		"@sveltejs/adapter-node": "^5.5.0",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.0.0",
		"@types/node": "24.10.13",
		"@types/nodemailer": "7.0.11",
		"@types/pg": "8.15.6",
		"drizzle-kit": "0.31.10",
		"shiki": "^4.4.3",
		"svelte": "5.56.5",
		"svelte-check": "4.4.6",
		"tailwind-merge": "^3.6.0",
		"typescript": "6.0.3",
		"vite": "8.1.4",
		"vitest": "4.1.11",
		"vue": "^3.5.41"
	}
}

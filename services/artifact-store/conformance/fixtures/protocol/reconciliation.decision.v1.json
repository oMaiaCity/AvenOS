{
  "typeKey": "reconciliation.decision",
  "version": 1,
  "schemaProfileId": "artifact-json-schema-profile-v1",
  "payloadSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["candidateArtifactId", "openItemArtifactId", "transactionArtifactId", "decision", "relation", "note"],
    "properties": {
      "candidateArtifactId": { "type": "string", "format": "uuid" },
      "openItemArtifactId": { "type": "string", "format": "uuid" },
      "transactionArtifactId": { "type": "string", "format": "uuid" },
      "decision": { "enum": ["accepted", "rejected"] },
      "relation": { "const": "supports-booking" },
      "note": { "type": ["string", "null"], "maxLength": 2000 }
    }
  },
  "blobPolicy": "forbidden",
  "referenceRules": []
}
